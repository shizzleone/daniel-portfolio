{"kind":"textbox","id":"sh/0zupsv2h","slideIndex":3,"position":{"left":56,"top":48,"width":260,"height":20},"text":"SENDORY","geometry":"rect","lineWidth":0,"style":{"fontSize":11,"typeface":"Aptos","color":"#5D6961","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/zyl8jq1c","slideIndex":3,"position":{"left":56,"top":82,"width":820,"height":80},"text":"The content model shaped the interface","geometry":"rect","lineWidth":0,"style":{"fontSize":42,"typeface":"Aptos","color":"#17211B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/exc7qlkr","slideIndex":3,"position":{"left":58,"top":170,"width":820,"height":48},"text":"I designed the system around the author’s decisions: start, assemble, refine, review.","geometry":"rect","lineWidth":0,"style":{"fontSize":18,"typeface":"Aptos","color":"#5D6961","alignment":"left"}}
{"kind":"textbox","id":"sh/qts7mlkf","slideIndex":3,"position":{"left":56,"top":570,"width":180,"height":20},"text":"WHAT I WOULD SAY","geometry":"rect","lineWidth":0,"style":{"fontSize":11,"typeface":"Aptos","color":"#5D6961","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/xsnqtkja","slideIndex":3,"position":{"left":240,"top":562,"width":850,"height":58},"text":"“I treated content structure as part of the product design. The template, block, and preview model determined how the author moved through the work.”","geometry":"rect","lineWidth":0,"style":{"fontSize":21,"typeface":"Aptos","color":"#17211B","bold":true,"alignment":"left"}}
