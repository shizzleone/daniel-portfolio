{"kind":"textbox","id":"sh/q18natk7","slideIndex":6,"position":{"left":240,"top":221,"width":460,"height":54},"text":"A multi-surface product needed consistent patterns, but content length, device, state, and user context changed from one experience to the next.","geometry":"rect","lineWidth":0,"style":{"fontSize":15,"typeface":"Aptos","color":"#17211B","alignment":"left"}}
